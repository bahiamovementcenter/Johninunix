--- /dev/null
+++ b/lib/adapters/jdex/none.sh
@@ -0,0 +1,32 @@
+# SPDX-License-Identifier: MIT
+# jdex/none.sh - the functions that a JDex store defines
+#
+# A store reads and writes a JDex that is not a folder of Markdown
+# notes. '"jdex": { "app": "bear" }' loads jdex/bear.sh. An app with no
+# file here, such as obsidian, is a folder of notes, and jd reads it
+# itself. 'none' is never loaded as a store: this file is the list of
+# what a store defines, and what to copy to write one. Refer to
+# lib/adapters/README.md.
+#
+# A store may set these when jd loads it:
+#
+#   _JD_JDEX_LABEL   its name in messages: 'the JDex in Bear'
+#   _JD_JDEX_UNIT    what a container is called: 'tag'
+#   _JD_JDEX_EXT     the extension of its templates, 'ID template.<ext>'
+#                    and 'Work package template.<ext>'. Default md
+
+jd_jdex_load() {
+  _jd_nav_err "this system has no JDex"
+  return 1
+}
+jd_jdex_find() { return 1; }
+jd_jdex_open() { return 1; }
+jd_jdex_open_app() { return 1; }
+jd_jdex_titles() { return 0; }
+jd_jdex_category() { return 0; }
+jd_jdex_wp_area() { return 0; }
+jd_jdex_where() { printf '%s' "$1"; }
+jd_jdex_write() {
+  cat >/dev/null
+  printf ''
+}
