# Writes nickel/generated/*.ncl: facts about the pinned jd, read from its
# source. Run by `nix run .#generate`; never edit the output by hand.
#
#   nu generate.nu SRC OUT VERSION OWNER REPO REV

def ncl-list [items: list<string>] {
  if ($items | is-empty) { return "[]" }
  $items | each { |i| $"  \"($i)\"," } | prepend "[" | append "]" | str join "\n"
}

def write-ncl [out: string, name: string, comment: string, body: string] {
  $"# ($comment)\n# Generated by nickel/generate.nu from the pinned jd. Do not edit.\n($body)\n"
  | save --force ($out | path join $"($name).ncl")
}

# Function names defined at the start of a line, like `_jd_new() {`
def functions-in [file: string] {
  open --raw $file | lines | parse --regex '^(?<name>[A-Za-z_][A-Za-z0-9_]*)\(\)' | get name
}

def main [src: string, out: string, version: string, owner: string, repo: string, rev: string] {
  mkdir $out

  write-ncl $out "upstream" "The jd revision these files describe" ([
    "{"
    $"  owner = \"($owner)\","
    $"  repo = \"($repo)\","
    $"  rev = \"($rev)\","
    $"  version = \"($version)\","
    "}"
  ] | str join "\n")

  let functions = ls ($src | path join "lib") | where name =~ '\.sh$' | get name
    | each { |f| functions-in $f } | flatten | uniq | sort
  write-ncl $out "functions" "jd's shell functions: the ones an extension may wrap" (ncl-list $functions)

  # The words _jd_nav treats as commands: `[ "${1-}" = word ]` tests and the
  # patterns of its `case` statements, like `move | undo)` or `-h|--help|help)`
  let nav = open --raw ($src | path join "lib" "nav.sh")
  let tested = $nav | parse --regex '\[ "\$\{1-\}" = (?<w>[a-z][a-z-]*) \]' | get w
  let cased = $nav | lines
    | parse --regex '^\s*(?<p>-{0,2}[a-z][a-z-]*(?:\s*\|\s*-{0,2}[a-z][a-z-]*)*)\)'
    | get p | each { |p| $p | split row '|' | str trim } | flatten
    | where { |w| not ($w | str starts-with '-') }
  write-ncl $out "commands" "jd's built-in commands: an extension's command must not reuse them" (
    ncl-list ($tested | append $cased | uniq | sort))

  let adapters = ls ($src | path join "lib" "adapters") | where type == dir | get name
    | each { |dir|
        let names = ls $dir | where name =~ '\.sh$' | get name | each { |f| $f | path parse | get stem } | sort
        {
          kind: ($dir | path basename)
          builtin: $names
          functions: (functions-in ($dir | path join "none.sh") | sort)
        }
      }
    | sort-by kind
  write-ncl $out "adapters" "Work-package adapters: the built-in ones, and the functions each kind must define" ([
    "{"
    ...($adapters | each { |a| [
      $"  ($a.kind) = {"
      $"    builtin = (ncl-list $a.builtin | str replace --all "\n" "\n    "),"
      $"    functions = (ncl-list $a.functions | str replace --all "\n" "\n    "),"
      "  },"
    ] } | flatten)
    "}"
  ] | str join "\n")
}
